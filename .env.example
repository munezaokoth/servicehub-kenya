# ServiceHub Kenya - environment variables (set these in Railway → Variables; never commit a real .env)

NODE_ENV=production
FRONTEND_URL=https://servicehub.co.ke

# Long random string (Railway can generate one)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Firebase Admin: paste the WHOLE service-account JSON file contents as one value
# (Firebase Console → Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"servicehub-kenya",...}

# Firebase Web API key (Project settings → General → Web API key). Lets users sign in after a password reset.
FIREBASE_WEB_API_KEY=AIza...

# Email via Resend (https://resend.com) - works on Railway (no SMTP blocking)
RESEND_API_KEY=re_...
EMAIL_FROM=support@servicehub.co.ke
EMAIL_FROM_NAME=ServiceHub Kenya

# ── Voice & video calls ──────────────────────────────────────────────
# TURN relay (REQUIRED for call audio on mobile data). Pick ONE option:
# A) Cloudflare Realtime TURN (free tier): dash.cloudflare.com → Realtime → TURN → Create
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# B) Metered.ca:  METERED_DOMAIN=yourapp.metered.live  METERED_API_KEY=...
# C) Own TURN:    TURN_URLS=turn:host:3478,turns:host:5349  TURN_USERNAME=...  TURN_CREDENTIAL=...

# Push alerts that make the phone ring (optional: generated automatically and stored in Firestore if empty)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@servicehub.co.ke
